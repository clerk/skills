---
import { Show, SignInButton, SignUpButton } from "@clerk/astro/components"
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Clerk + Astro</title>
  </head>
  <body>
    <header>
      <Show when="signed-out">
        <SignInButton mode="modal" />
        <SignUpButton mode="modal" />
      </Show>
      <Show when="signed-in">
        <p>You are signed in!</p>
      </Show>
    </header>
    <slot />
  </body>
</html>
